# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth / Auth.js Configuration
AUTH_SECRET="your_auth_secret_here_random_string_32_chars"
NEXTAUTH_SECRET="your_auth_secret_here_random_string_32_chars"
NEXTAUTH_URL="https://cloudlab.up.railway.app"
AUTH_URL="https://cloudlab.up.railway.app"
AUTH_TRUST_HOST="true"

# GitHub OAuth App Credentials (for Sign-in and Repository Import)
AUTH_GITHUB_ID="your_github_oauth_client_id"
AUTH_GITHUB_SECRET="your_github_oauth_client_secret"
GITHUB_ID="your_github_oauth_client_id"
GITHUB_SECRET="your_github_oauth_client_secret"

# AI Assistant API Keys (Optional - at least one recommended for IDE AI Chat)
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Feature Flags
AGENT_DEV_LOCAL_EXECUTION="false"
LOG_LEVEL="info"