FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git make g++ build-essential python3 python3-pip procps \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1001 cloudlab \
    && useradd --uid 1001 --gid 1001 --create-home --shell /bin/bash cloudlab \
    && mkdir -p /workspace \
    && chown cloudlab:cloudlab /workspace

WORKDIR /workspace
USER cloudlab
CMD ["sleep", "infinity"]
